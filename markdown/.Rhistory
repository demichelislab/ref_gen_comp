bygroup <- function(x, group, fun = sum, ...) {
splitted <- split(x, group)
funned   <- lapply(splitted, fun, ...)
funned   <- mapply(function(x, y) {
rep(x, length(y))
}, x = funned, y = splitted)
unsplit(funned, group)
}
