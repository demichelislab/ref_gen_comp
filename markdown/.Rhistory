samples <- sif$sample
bkp_list <- lapply(samples, function(x)
if(file.exists(paste0(analysis_path, "telo_bkp_h/", x, ".tsv"))){
fread(paste0(analysis_path, "telo_bkp_h/", x, ".tsv")) %>% mutate(sample = x,
chr = as.character(chr),
supporting_read_names = as.character(supporting_read_names))
})
bkp_list <- purrr::discard(bkp_list, ~is.null(.) )
bkp_list <- purrr::discard(bkp_list, ~nrow(.) < 1 )
bkp_df <- bind_rows(bkp_list) %>% filter(chr %in% chromosomes )
bkp_df <- full_join(bkp_df, sif)
bkp_df$tp <- substr(bkp_df$sample, 9, 11)
bkp_df$patient <- substr(bkp_df$sample, 1, 7)
bygroup <- function(x, group, fun = sum, ...) {
splitted <- split(x, group)
funned   <- lapply(splitted, fun, ...)
funned   <- mapply(function(x, y) {
rep(x, length(y))
}, x = funned, y = splitted)
unsplit(funned, group)
}
