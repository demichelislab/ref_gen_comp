bkp_df <- bkp_df %>%
mutate(shared = ifelse(duplicated(pos) | duplicated(pos, fromLast=TRUE), "Yes", "No"))
bkp_df <- bkp_df %>% mutate(pos = start) %>%
mutate(shared = ifelse(duplicated(pos) | duplicated(pos, fromLast=TRUE), "Yes", "No"))
match_df <- bkp_df %>% group_by(pos, chr, shared) %>%
summarize(timepoint = paste0(sort(unique(tp)), collapse = "|"),
stat = case_when(grepl("\\|", timepoint) & shared == "Yes" ~  "Shared multiple timepoints",
!grepl("\\|", timepoint) & shared == "Yes" ~ "Shared same timepoint",
.default = "Unique"))
bkp_df <- left_join(bkp_df, match_df %>% distinct(pos, chr, stat))
(ggplot(bkp_df %>% distinct(chr,pos, stat) %>% filter(!is.na(chr)),
aes(y = "", fill = stat))
+ geom_bar()
+ theme_bw(base_size = 12)
+ geom_label_repel(stat = "count",
aes(label = paste(after_stat(count),"\n",
scales::percent(after_stat(count) / sum(after_stat(count))))
), position = position_stack(0.5), show.legend = F, color = "White")
+ theme(legend.position = "bottom", axis.ticks.y = element_blank())
+ scale_fill_manual(values = c("Unique" = "gray60", "Shared same timepoint" = "#32a4a7", "Shared multiple timepoints" = "#44d1df"))
+ labs(x="N unique breakpoints", y = "", fill = "Breakpoint status")
)
